{
  "name": "@batle/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc --noEmit",
    "start": "node --import tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "provision": "node --import tsx --env-file=.env src/gm/provision.ts"
  },
  "dependencies": {
    "fastify": "5.0.0",
    "@fastify/cors": "10.0.1",
    "@fastify/rate-limit": "10.1.1",
    "pg": "8.13.0",
    "ioredis": "5.4.1",
    "nats": "2.28.0",
    "jsonwebtoken": "9.0.2",
    "bcrypt": "5.1.1",
    "zod": "3.23.8",
    "pino-pretty": "11.3.0"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/jsonwebtoken": "9.0.7",
    "@types/bcrypt": "5.0.2",
    "@types/node": "22.7.5",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
